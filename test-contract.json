{
  "contractVersion": "2.0.0",
  "phase": 3,
  "assumptionNote": "Phase 3 breaking replacement per docs/notes/phase-3-change-log.md: player.hp replaced by player.lanternOil; added lantern charge and resonanceActive.",
  "entrypoint": "npm run headless -- --scenario <path> [--out <path>]",
  "determinism": true,
  "constants": {
    "dt": 0.05,
    "tickRateHz": 20,
    "islandRadius": 24,
    "playerSpeed": 6.0,
    "playerRadius": 0.6,
    "fireflyPickupRadius": 1.3,
    "lanternInteractRadius": 2.4,
    "firefliesPerLantern": 2,
    "lanternSafeRadius": 5.5,
    "oilMax": 100,
    "oilMistDrainPerSec": 1.8,
    "oilSanctuaryRechargePerSec": 12.0,
    "oilShadowHitCost": 35,
    "lanternChargeMax": 100,
    "lanternDecayShadowRadius": 9.0,
    "lanternDecayPerSec": 8.0,
    "lanternResonanceMinCount": 2,
    "lanternResonanceRecoverPerSec": 4.0,
    "shadowContactRadius": 1.2,
    "shadowInvulnTicks": 20,
    "shadowSpeed": 2.5,
    "shadowAlertRadius": 7.5,
    "shadowChaseSpeed": 3.4,
    "shadowChaseExitRadius": 10.5,
    "flareRadius": 7.0,
    "flareStunTicks": 60,
    "flareCooldownTicks": 80,
    "flareKnockback": 4.0
  },
  "inputSchema": {
    "scenarioId": "string",
    "levelId": "string (level-1 | level-2, default: level-1)",
    "seed": "integer",
    "maxTicks": "integer > 0",
    "inputs": [
      {
        "fromTick": "integer >= 1",
        "toTick": "integer >= fromTick",
        "moveX": "number [-1..1]",
        "moveZ": "number [-1..1]",
        "interact": "boolean (optional)",
        "flare": "boolean (optional)"
      }
    ]
  },
  "outputSchema": {
    "contractVersion": "string",
    "phase": "integer",
    "scenarioId": "string",
    "levelId": "string",
    "seed": "integer",
    "status": "running | won | lost",
    "ticksElapsed": "integer",
    "simTimeSec": "number",
    "player": {
      "x": "number",
      "z": "number",
      "lanternOil": "number (0..100)",
      "carriedFireflies": "integer",
      "flaresUsed": "integer",
      "flareCooldownTicks": "integer"
    },
    "lanternsLit": "integer",
    "lanternsTotal": "integer",
    "resonanceActive": "boolean",
    "lanterns": "Array<{ id, lit, charge }>",
    "firefliesCollected": "integer",
    "firefliesTotal": "integer",
    "shadows": "Array<{ id, x, z, aiState }>",
    "events": "SimEvent[]",
    "digestSha256": "64-char hex SHA-256 over canonical payload excluding digestSha256"
  }
}
