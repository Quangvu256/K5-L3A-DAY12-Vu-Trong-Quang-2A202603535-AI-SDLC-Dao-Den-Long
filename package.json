{
  "name": "dao-den-long",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Đảo Đèn Lồng — 3D third-person game with deterministic headless core for Day 12 AI SDLC",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "headless": "tsx src/headless/cli.ts",
    "verify": "node scripts/verify-all.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/three": "^0.174.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
